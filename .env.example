# Copy to .env (never commit it) or set as platform secrets.
# Live Claude annotation + model verifier (optional)
ANTHROPIC_API_KEY=
ROBOTRACE_CLAUDE_MODEL=claude-opus-5-5
# Primary vision engine: Muse Spark via OpenCode Go (optional; see README for data-use terms)
OPENCODE_GO_API_KEY=
ROBOTRACE_MUSE_MODEL=muse-spark-1.3-contributor
ROBOTRACE_OPENCODE_GO_URL=https://opencode.ai/zen/go/v1
ROBOTRACE_OPENCODE_TIMEOUT_S=180
# Frame sampling for muse / gemini: windowed (default, covers the full video) or legacy (1 request, cheaper
# but sparse on long videos)
ROBOTRACE_SAMPLING=windowed
ROBOTRACE_FRAME_SPACING_S=0.5
ROBOTRACE_WINDOW_OVERLAP_S=1.0
ROBOTRACE_MAX_WINDOWS=4
# Live Gemini annotation (optional)
GEMINI_API_KEY=
ROBOTRACE_GEMINI_MODEL=gemini-3.8-flash
ROBOTRACE_GEMINI_TIMEOUT_S=180
# Remote GPU notebook (optional)
ROBOTRACE_REMOTE_URL=
ROBOTRACE_REMOTE_TOKEN=
ROBOTRACE_REMOTE_TIMEOUT_S=300
# Limits
ROBOTRACE_MAX_UPLOAD_MB=500
ROBOTRACE_MAX_DURATION_S=1200
ROBOTRACE_MAX_FRAMES=24
ROBOTRACE_WORK_DIR=
